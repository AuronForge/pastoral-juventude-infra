COMPOSE_PROJECT_NAME=pastoral-juventude

FRONTEND_IMAGE=ghcr.io/auronforge/pastoral-juventude-frontend:0.1.0
BACKEND_IMAGE=ghcr.io/auronforge/pastoral-juventude-backend:0.1.0

POSTGRES_DB=pastoral
POSTGRES_USER=pastoral
POSTGRES_BACKUP_PATH=/mnt/pastoral-backup/postgres
BACKUP_INTERVAL_SECONDS=86400

GRAFANA_ADMIN_USER=admin
GRAFANA_BIND_ADDRESS=127.0.0.1

TAILSCALE_HOSTNAME=pastoral-juventude

ALERT_SMTP_SMARTHOST=smtp.example.com:587
ALERT_SMTP_FROM=alertas@example.com
ALERT_SMTP_USERNAME=alertas@example.com
ALERT_EMAIL_TO=operacao@example.com

SECRETS_DIR=/opt/pastoral/secrets
