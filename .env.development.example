# Copy to /opt/pastoral/dev/development.env; configure both initial image SHAs.
BACKEND_IMAGE=ghcr.io/auronforge/pastoral-juventude-backend:dev-REPLACE_WITH_40_CHAR_SHA
MIGRATION_IMAGE=ghcr.io/auronforge/pastoral-juventude-backend:dev-REPLACE_WITH_40_CHAR_SHA-migrations
FRONTEND_IMAGE=ghcr.io/auronforge/pastoral-juventude-frontend:dev-REPLACE_WITH_40_CHAR_SHA
SECRETS_DIR=/opt/pastoral/dev/secrets
POSTGRES_DB=pastoral_dev
POSTGRES_USER=pastoral
DEV_BIND_ADDRESS=127.0.0.1
DEV_HTTP_PORT=8080
DEV_PUBLIC_URL=http://localhost:8080
COOKIE_SECURE=false
